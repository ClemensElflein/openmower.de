{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{ range .Data.Pages }}
{{ if not (partial "noindex.html" .) }}
  <url>
    <loc>{{ partial "canonical-url.html" . }}</loc>
    {{ if .IsTranslated }}{{ range .AllTranslations }}{{ if not (partial "noindex.html" .) }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ partial "canonical-url.html" . }}" />
    {{ if eq .Language.Lang "en" }}<xhtml:link rel="alternate" hreflang="x-default" href="{{ partial "canonical-url.html" . }}" />{{ end }}
    {{ end }}{{ end }}{{ end }}
    {{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
    {{ with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
    {{ if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
{{ end }}
{{ end }}
</urlset>
